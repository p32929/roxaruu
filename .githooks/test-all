#!/usr/bin/env bash
# Every test on this system: the unit tests and (macOS, Linux) the UI
# walkthroughs, in a few processes side by side. Tests share their HOME
# (settings, shell files), so each process gets its own scratch one and runs
# its share one at a time. Used by pre-push and CI. SHARDS=n to choose how
# many; PROFILE=ci-test for CI's faster build; PART=i PARTS=n for this
# machine's share when n machines split them.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root"
here=$(cd "$(dirname "$0")" && pwd)
profile=${PROFILE:-release} part=${PART:-0} parts=${PARTS:-1}
cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 2)
shards=${SHARDS:-$(( cpus / 2 > 1 ? cpus / 2 : 1 ))}
# Windows: the walkthroughs need a Unix shell (they stay ignored there), and
# one process, as its tests were never made to run side by side.
ignored=--include-ignored
if [ "$("$here/platform")" = Windows ]; then
  ignored= shards=${SHARDS:-1}
fi
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

cargo build --profile "$profile" # the tests use roxaruu-hook beside them
bin=$(cargo test --profile "$profile" --bin roxaruu --no-run --message-format=json 2>/dev/null |
  jq -r 'select(.profile.test == true and .target.name == "roxaruu") | .executable' | tail -1)
[ "$part" = 0 ] && cargo test --profile "$profile" --bin roxaruu-hook -- --test-threads=1 2>&1 | "$here/format-tests" hook

# The slowest first, so they land in different shards; then the rest in turn.
slow=(remote_input_in_chrome remote_frames_in_chrome agent_alerts remote_in_chrome
  a_mark_stays_on_the_text editor_features_walkthrough terminal_says_whether idle_and_startup disk_changes)
all=$("$bin" --list $ignored 2>/dev/null | sed -n 's/: test$//p' | tr -d '\r')
# Every n-th from the slow-first list: each machine gets its share of the slow ones.
ordered=$( { for s in "${slow[@]}"; do grep -- "$s" <<<"$all" || true; done; cat <<<"$all"; } |
  awk -v p="$part" -v n="$parts" '!seen[$0]++ && (k++ % n) == p')
i=0
while read -r name; do
  echo "$name" >> "$scratch/list$(( i % shards ))"
  i=$(( i + 1 ))
done <<<"$ordered"

echo "test-all: $i tests in $shards processes${PARTS:+ (part $(( part + 1 )) of $parts)}"
pids=()
for n in $(seq 0 $(( shards - 1 ))); do
  [ -s "$scratch/list$n" ] || continue
  home="$scratch/home$n"
  mkdir -p "$home"
  # Ubuntu's global zshrc runs compinit, which stops to ask about folders.
  echo 'skip_global_compinit=1' > "$home/.zshenv"
  # Each test's line as it finishes (format-tests), the whole output kept.
  HOME="$home" SHOTS="${SHOTS:-$root/target/shots}" PROJECT="$root/src/main.rs" BIG="$root/src/ui.rs" \
    "$bin" $ignored --test-threads=1 --exact $(cat "$scratch/list$n") 2>&1 |
    tee "$scratch/log$n" | "$here/format-tests" "$n" &
  pids+=("$!:$n")
done
start=$SECONDS
for p in "${pids[@]}"; do
  wait "${p%%:*}" || true
done
# Passed only if every process ran to its "test result: ok" (a crash or a
# failure says otherwise; the formatter's own exit code doesn't know).
failed=0
for n in $(seq 0 $(( shards - 1 ))); do
  [ -s "$scratch/list$n" ] || continue
  grep -q "^test result: ok" "$scratch/log$n" || failed=1
done
# Why each failure failed, after the live list.
for n in $(seq 0 $(( shards - 1 ))); do
  [ -f "$scratch/log$n" ] || continue
  if grep -q "^failures:" "$scratch/log$n"; then
    echo
    echo "---- [$n] failures:"
    sed -n '/^failures:/,/^test result/p' "$scratch/log$n"
  fi
done
passed=$(cat "$scratch"/log* | grep -c " \.\.\. ok$" || true)
fails=$(cat "$scratch"/log* | grep -c " \.\.\. FAILED$" || true)
echo
echo "test-all: $passed passed, $fails failed, in $(( SECONDS - start ))s"
exit $failed
