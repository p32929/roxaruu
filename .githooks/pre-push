#!/bin/sh
# Before anything leaves this machine: this system's whole test suite, here
# (CI runs the other systems; see prepare-commit-msg). A failure stops the
# push. Pushing only tags, or deleting a branch, tests nothing.
set -e
z=0000000000000000000000000000000000000000
branches=0
while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in refs/tags/*) continue ;; esac
  [ "$local_sha" = "$z" ] && continue
  branches=1
done
[ "$branches" = 0 ] && exit 0

platform=$("$(dirname "$0")/platform")
root=$(git rev-parse --show-toplevel)
cd "$root"
echo "pre-push: $platform tests, here (CI tests the other systems)"
cargo clippy --release --all-targets -- -D warnings
if [ "$platform" = Windows ]; then
  cargo build --release # the tests use roxaruu-hook beside them
  cargo test --release
else
  "$(dirname "$0")/test-all" # every test, in a few processes, scratch homes
fi
echo "pre-push: $platform tests passed"
