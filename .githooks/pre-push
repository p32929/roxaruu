#!/usr/bin/env bash
# Before anything leaves this machine: this system's whole test suite, here
# (the others run with a release: .githooks/release). A failure stops the
# push. Pushing only tags or docs, or deleting a branch, tests nothing.
set -eo pipefail
z=0000000000000000000000000000000000000000
branches=0
while read -r _ local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/tags/*) continue ;; esac
  [ "$local_sha" = "$z" ] && continue
  # Only docs changed (CI skips those too): nothing to test.
  if [ "$remote_sha" != "$z" ] && git cat-file -e "$remote_sha" 2>/dev/null &&
    [ -z "$(git diff --name-only "$remote_sha" "$local_sha" | grep -v '\.md$')" ]; then
    continue
  fi
  branches=1
done
[ "$branches" = 0 ] && exit 0

platform=$("$(dirname "$0")/platform")
root=$(git rev-parse --show-toplevel)
cd "$root"
echo "pre-push: $platform tests, here (every system, and a release: .githooks/release)"
cargo clippy --release --all-targets -- -D warnings
"$(dirname "$0")/test-all" # every test, in a few processes, scratch homes
echo "pre-push: $platform tests passed"
